+    def testLineLabelingRepeatDistance(self):
+        """Test that a line labelingInfo entry with "repeatLabel"/"repeatLabelDistance"
+        is correctly translated to a repeat distance on the resulting label settings,
+        so that long line features get relabeled at regular intervals instead of only once"""
+
+        endpoint = self.basetestpath + "/repeat_label_fake_qgis_http_endpoint"
+        with open(self.sanitize_local_url(endpoint, "?f=json"), "wb") as f:
+            f.write(
+                b"""
+        {"currentVersion":11.3,"id":1,"name":"QGIS Test","type":"Feature Layer","description":
+        "QGIS Provider Test Layer","geometryType":"esriGeometryPolyline","copyrightText":"not copyright","parentLayer":null,"subLayers":[],
+        "minScale":0,"maxScale":0,
+        "defaultVisibility":true,
+        "extent":{"xmin":-71.123,"ymin":66.33,"xmax":-65.32,"ymax":78.3,
+        "spatialReference":{"wkid":4326,"latestWkid":4326}},
+        "hasAttachments":false,"htmlPopupType":"esriServerHTMLPopupTypeAsHTMLText",
+        "displayField":"Hierarchie","typeIdField":null,
+        "fields":[{"name":"OBJECTID","type":"esriFieldTypeOID","alias":"OBJECTID","domain":null},
+        {"name":"Hierarchie","type":"esriFieldTypeString","alias":"Hierarchie","length":50,"domain":null}],
+        "relationships":[],"canModifyLayer":false,"canScaleSymbols":false,"hasLabels":true,
+        "capabilities":"Map,Query,Data","maxRecordCount":1000,"supportsStatistics":true,
+        "supportsAdvancedQueries":true,"supportedQueryFormats":"JSON, AMF",
+        "drawingInfo":{
+         "renderer": {
+          "type": "simple",
+          "symbol": {
+           "type": "esriSLS",
+           "style": "esriSLSSolid",
+           "color": [0, 92, 230, 255],
+           "width": 2
+          }
+         },
+         "labelingInfo": [
+          {
+           "labelExpression": "[Hierarchie]",
+           "labelPlacement": "esriServerLinePlacementCenterAlong",
+           "repeatLabel": true,
+           "repeatLabelDistance": 290,
+           "where": "(\\"Hierarchie\\" = 'XXXX')",
+           "maxScale": 0,
+           "minScale": 0,
+           "symbol": {
+            "type": "esriTS",
+            "color": [0, 92, 230, 255],
+            "haloColor": [251, 251, 251, 255],
+            "haloSize": 2,
+            "font": {"family": "Arial", "size": 14, "style": "normal", "weight": "bold"}
+           }
+          }
+         ]
+        },
+        "ownershipBasedAccessControlForFeatures":{"allowOthersToQuery":true},"useStandardizedQueries":true}"""
+            )
+
+        with open(
+            self.sanitize_local_url(
+                endpoint, "/query?f=json_where=1=1&returnIdsOnly=true"
+            ),
+            "wb",
+        ) as f:
+            f.write(
+                b"""
+        {
+         "objectIdFieldName": "OBJECTID",
+         "objectIds": [
+          1
+         ]
+        }
+        """
+            )
+
+        # Create test layer
+        vl = QgsVectorLayer(
+            "url='http://" + endpoint + "' crs='epsg:4326'",
+            "test",
+            "arcgisfeatureserver",
+        )
+        self.assertTrue(vl.isValid())
+        self.assertTrue(vl.labelsEnabled())
+        self.assertIsInstance(vl.labeling(), QgsRuleBasedLabeling)
+
+        root_rule = vl.labeling().rootRule()
+        self.assertEqual(len(root_rule.children()), 1)
+        settings = root_rule.children()[0].settings()
+        self.assertEqual(settings.placement, Qgis.LabelPlacement.Line)
+        self.assertEqual(settings.repeatDistance, 290)
+        self.assertEqual(settings.repeatDistanceUnit, Qgis.RenderUnit.Points)
+

From 3e9d9f0f749f634ccda840f5ddc22bf02ee75192 Mon Sep 17 00:00:00 2001
From: Nyall Dawson <nyall.dawson@gmail.com>
Date: Fri, 21 Aug 2026 13:05:29 +1000
Subject: [PATCH 4/7] [api] Add billboard scale mode support to
 QgsPoint3DBillboardMaterial

Allows creation of perspective corrected billboards, which scale
size by distance from the camera but are always oriented to face
directly at the camera
---
 python/PyQt6/core/auto_additions/qgis.py      | 13 ++++
 python/PyQt6/core/auto_generated/qgis.sip.in  |  6 ++
 src/3d/shaders/billboards.vert                | 51 ++++++++++-----
 .../symbols/qgspoint3dbillboardmaterial.cpp   | 62 ++++++++++++++-----
 src/3d/symbols/qgspoint3dbillboardmaterial.h  |  5 +-
 src/core/qgis.h                               | 12 ++++
 6 files changed, 115 insertions(+), 34 deletions(-)

diff --git a/python/PyQt6/core/auto_additions/qgis.py b/python/PyQt6/core/auto_additions/qgis.py
index ce67d10067f..11721fe88c0 100644
--- a/python/PyQt6/core/auto_additions/qgis.py
+++ b/python/PyQt6/core/auto_additions/qgis.py
@@ -7862,6 +7862,19 @@ Qgis.InstancedMaterialFlags = lambda flags=0: Qgis.InstancedMaterialFlag(flags)
 Qgis.InstancedMaterialFlags.baseClass = Qgis
 InstancedMaterialFlags = Qgis  # dirty hack since SIP seems to introduce the flags in module
 # monkey patching scoped based enum
+Qgis.BillboardScaleMode.ViewIndependent.__doc__ = "Billboard has a fixed pixel size on the screen, regardless of the camera distance"
+Qgis.BillboardScaleMode.Perspective.__doc__ = "Billboard size is scaled with perspective distance from camera, using world units"
+Qgis.BillboardScaleMode.__doc__ = """3D billboard scaling modes.
+
+.. versionadded:: 4.4
+
+* ``ViewIndependent``: Billboard has a fixed pixel size on the screen, regardless of the camera distance
+* ``Perspective``: Billboard size is scaled with perspective distance from camera, using world units
+
+"""
+# --
+Qgis.BillboardScaleMode.baseClass = Qgis
+# monkey patching scoped based enum
 Qgis.TextureFilterQuality.Trilinear.__doc__ = "Trilinear (LinearMipmapLinear)"
 Qgis.TextureFilterQuality.Anisotropic2x.__doc__ = "Anisotropic filtering (2x)"
 Qgis.TextureFilterQuality.Anisotropic4x.__doc__ = "Anisotropic filtering (4x)"
diff --git a/python/PyQt6/core/auto_generated/qgis.sip.in b/python/PyQt6/core/auto_generated/qgis.sip.in
index 73906f9ad3f..155d4c62f9b 100644
--- a/python/PyQt6/core/auto_generated/qgis.sip.in
+++ b/python/PyQt6/core/auto_generated/qgis.sip.in
@@ -2466,6 +2466,12 @@ The development version
     typedef QFlags<Qgis::InstancedMaterialFlag> InstancedMaterialFlags;
 
 
+    enum class BillboardScaleMode /BaseType=IntEnum/
+    {
+      ViewIndependent,
+      Perspective
+    };
+
     enum class TextureFilterQuality /BaseType=IntEnum/
     {
       Trilinear,

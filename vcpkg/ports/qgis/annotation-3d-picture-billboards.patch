From 3ee38634ca7a00d12b11f7c89fe34cb6187b095d Mon Sep 17 00:00:00 2001
From: Nyall Dawson <nyall.dawson@gmail.com>
Date: Mon, 24 Aug 2026 09:04:57 +1000
Subject: [PATCH 1/7] Fix incorrectly culled billboard entities in 3d views

Avoids the console being spammed with the qt warning:

"findBoundingVolumeComputeData: Position attribute not suited for
bounding volume computation warnings"

and missing billboard entities in 3d views, due to incorrectly culled
entities
---
 src/3d/symbols/qgsbillboardgeometry.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/3d/symbols/qgsbillboardgeometry.cpp b/src/3d/symbols/qgsbillboardgeometry.cpp
index 08e7505d00a..e95ac83eee8 100644
--- a/src/3d/symbols/qgsbillboardgeometry.cpp
+++ b/src/3d/symbols/qgsbillboardgeometry.cpp
@@ -68,6 +68,7 @@ void QgsBillboardGeometry::setMode( Mode mode )
   mPositionAttribute->setByteStride( stride );
   mPositionAttribute->setName( Qt3DCore::QAttribute::defaultPositionAttributeName() );
   addAttribute( mPositionAttribute );
+  setBoundingVolumePositionAttribute( mPositionAttribute );
 
   switch ( mode )
   {
@@ -178,6 +179,7 @@ void QgsBillboardGeometry::setPositions( const QVector<QVector3D> &vertices )
 
   mVertexCount = vertices.count();
   mVertexBuffer->setData( vertexBufferData );
+  mPositionAttribute->setCount( mVertexCount );
 
   emit countChanged( mVertexCount );
 }
@@ -248,6 +250,7 @@ void QgsBillboardGeometry::setBillboardData( const QVector<BillboardAtlasData> &
 
   mVertexCount = billboards.count();
   mVertexBuffer->setData( vertexBufferData );
+  mPositionAttribute->setCount( mVertexCount );
 
   emit countChanged( mVertexCount );
 }


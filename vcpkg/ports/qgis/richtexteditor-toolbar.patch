From 6d42484468e10e883fa5294203530844cfb60971 Mon Sep 17 00:00:00 2001
From: Denis Rouzaud <denis.rouzaud@gmail.com>
Date: Tue, 8 Sep 2026 12:14:41 +0200
Subject: [PATCH 3/3] Honour EXIF orientation when inserting an image from a
 file

A photo taken on a phone carries its rotation in EXIF metadata rather
than in the pixels, so QImageReader hands back a sideways image unless
asked to apply it.
---
 src/gui/qgsrichtexteditor.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/gui/qgsrichtexteditor.cpp b/src/gui/qgsrichtexteditor.cpp
index 0cd07e50003..c8b659afe9c 100644
--- a/src/gui/qgsrichtexteditor.cpp
+++ b/src/gui/qgsrichtexteditor.cpp
@@ -796,7 +796,11 @@ void QgsRichTextEditor::insertImage()
   if ( file.isEmpty() )
     return;
 
-  const QImage image = QImageReader( file ).read();
+  QImageReader reader( file );
+  // Honour any EXIF orientation, so a photo taken on a phone does not come in
+  // on its side.
+  reader.setAutoTransform( true );
+  const QImage image = reader.read();
 
   mTextEdit->dropImage( image, QFileInfo( file ).suffix().toUpper().toLocal8Bit().data() );
 }
-- 

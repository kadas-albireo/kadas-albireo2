class KadasAnnotationItemContext
{
%Docstring(signature="appended")
Bundles the per-call context that \c KadasAnnotationItemController needs
for map-space ↔ item-space transforms.
%End

%TypeHeaderCode
#include "kadas/gui/annotationitems/kadasannotationitemcontext.h"
%End
  public:
    KadasAnnotationItemContext();
    KadasAnnotationItemContext( QgsAnnotationLayer *layer, const QgsMapSettings &mapSettings );

    QgsAnnotationLayer *layer() const;
%Docstring
Owning annotation layer.
%End

    const QgsMapSettings &mapSettings() const;
%Docstring
Map canvas settings; \c
:py:func:`~KadasAnnotationItemContext.destinationCrs` is the map CRS.
%End

    QgsCoordinateReferenceSystem itemCrs() const;
%Docstring
CRS of the item, i.e. the parent annotation layer's CRS.
%End

    Qt::KeyboardModifiers modifiers() const;
%Docstring
Keyboard modifiers active during the current edit (e.g. Shift for angle
snapping).
%End
    void setModifiers( Qt::KeyboardModifiers modifiers );

    bool digitizing() const;
%Docstring
``True`` while the item is still being digitized. Handles that only make
sense on a finished shape (midpoint insert handles) are left out then,
so the trailing rubber-band segment does not sprout one that chases the
cursor.
%End
    void setDigitizing( bool digitizing );

    QgsPointXY cursorPos() const;
%Docstring
Pointer position in map coordinates, empty when it is unknown (pointer
off the canvas, or a caller that has none). Handles that would clutter
the shape if they were all shown at once - the midpoint insert handles -
only appear near it.
%End
    void setCursorPos( const QgsPointXY &cursorPos );


};

